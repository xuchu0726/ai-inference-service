#!/bin/bash
#PBS -N seed_2gpu_probe
#PBS -q v1_gpu72
#PBS -l select=1:ncpus=8:mem=128gb:ngpus=2
#PBS -l walltime=00:15:00
#PBS -j oe

set -u

cd "$PBS_O_WORKDIR"

module purge
module load tools/prod
module load PyTorch/2.1.2-foss-2023a-CUDA-12.1.1

echo "===== JOB INFO ====="
echo "Job ID: ${PBS_JOBID:-unknown}"
echo "Host: $(hostname)"
echo "Workdir: $(pwd)"
echo "Date: $(date)"

echo
echo "===== NVIDIA SMI ====="
nvidia-smi || true

echo
echo "===== TORCH MULTI GPU CHECK ====="
python - <<'PY'
import torch

print("torch:", torch.__version__)
print("torch cuda version:", torch.version.cuda)
print("cuda available:", torch.cuda.is_available())
print("device count:", torch.cuda.device_count())

if torch.cuda.is_available():
    total_visible = 0
    for i in range(torch.cuda.device_count()):
        props = torch.cuda.get_device_properties(i)
        free, total = torch.cuda.mem_get_info(i)
        total_gb = props.total_memory / 1024**3
        total_visible += total_gb
        print(f"GPU {i} name:", props.name)
        print(f"GPU {i} total memory GB:", round(total_gb, 2))
        print(f"GPU {i} free memory GB:", round(free / 1024**3, 2))

    print("aggregate visible GPU memory GB:", round(total_visible, 2))

    for i in range(torch.cuda.device_count()):
        x = torch.randn((1024, 1024), device=f"cuda:{i}")
        y = x @ x
        torch.cuda.synchronize(i)
        print(f"GPU {i} matmul OK:", tuple(y.shape))
PY

echo "===== DONE ====="
